# Порт, на якому працює API
PORT=3000

# Секрет для підпису токенів адміністратора.
# Якщо залишити порожнім — буде згенеровано автоматично та збережено в data/.jwt-secret
JWT_SECRET=

# Логін і пароль адміністратора, який створюється при першому запуску.
# ОБОВ'ЯЗКОВО змініть пароль перед публікацією сайту!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# Шлях до файлу бази даних (необов'язково)
# DB_PATH=./data/shop.db

# Адреса фронтенду (для CORS у режимі розробки)
CLIENT_URL=http://localhost:5173

# Адреса сайту після публікації (для sitemap.xml), напр. https://agromarket.ua
# SITE_URL=

# ---------- AI-помічник (Claude) ----------
# Ключ API Anthropic: https://platform.claude.com → API Keys.
# Без ключа сайт працює як звичайно, просто кнопка помічника буде прихована.
ANTHROPIC_API_KEY=
# Модель (за замовчуванням claude-opus-5-5). Дешевший варіант: claude-haiku-5-5
# ASSISTANT_MODEL=claude-opus-5-5
# Ретельність відповідей: low (швидко, дешево) | medium | high
# ASSISTANT_EFFORT=low
